# Copy to app/.env.local (Next.js) and fill in. Never commit real values.

# --- Server-only (never expose to the browser) ---
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# World ID environment the server accepts: production (default) or staging (simulator only)
WORLD_ENVIRONMENT=
# real (default) or simulated (demo only: no World ID proof, credential level SIMULATED, responses marked simulated)
WORLD_ID_MODE=
ATTESTER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
SEPOLIA_RPC_URL=
# Chain whose config/<chainId>.json the app reads (default 11155111 = Sepolia; 31337 = local anvil)
CHAIN_ID=
# Optional until CC-13 (GitHub merge)
GITHUB_TOKEN=
# Default in development: file:./dev.db (SQLite). Required in production (Neon Postgres URL)
DATABASE_URL=
# Local git checkouts the server recomputes commit hashes from: <REPOS_ROOT>/<owner>/<name> (approvals are off when unset)
REPOS_ROOT=
# Demo only (optional): admin key used by the server to grant the "validator" preset after enrollment
DEPLOYER_PRIVATE_KEY=

# --- Public (bundled into client code) ---
NEXT_PUBLIC_WORLD_APP_ID=
